{
  "name": "restaurant-software",
  "main": "server/index.js",
  "compatibility_date": "2026-11-01",

  // React build (npm run build -> dist/) is served as static files.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",

    // /api/* goes to the Hono Worker FIRST. Without this line the SPA fallback
    // would answer API URLs with index.html.
    "run_worker_first": ["/api/*"]
  },

  // Database. Create it once:  npx wrangler d1 create restrodesk
  // then paste the database_id it prints below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restrodesk",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE",
      "migrations_dir": "server/db/migrations"
    }
  ],

  // Normal (non-secret) settings. Secrets are NOT written here, see .dev.vars.example
  "vars": {
    // Admin login email. The admin PASSWORD is a secret.
    "ADMIN_EMAIL": "admin@restrodesk.com",

    // Password hashing strength (max 100000 on Cloudflare). If the Free plan shows
    // "Exceeded CPU" while logging in, lower this, for example to 20000.
    "PBKDF2_ITERATIONS": "100000"
  }
}