{
  "name": "restaurant-software",
  "main": "server/index.js",
  "compatibility_date": "2026-11-01",

  // React build (npm run build -> dist/) is served as static files.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",

    // /api/* goes to the Hono Worker FIRST. Without this line the SPA fallback
    // would answer API URLs with index.html.
    "run_worker_first": ["/api/*"]
  },

  // Database (Cloudflare D1)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restrodesk",
      "database_id": "831228d0-808f-4569-bac1-af1aedeb656c",
      "migrations_dir": "server/db/migrations"
    }
  ],

  // Normal (non-secret) settings. Secrets are NOT written here.
  "vars": {
    "ADMIN_EMAIL": "admin@restrodesk.com",
    "PBKDF2_ITERATIONS": "100000"
  }
}